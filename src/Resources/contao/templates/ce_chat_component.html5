<?php
$widgetId = $this->templateId;
$assistantId = $this->assistantId;
$assistantName = $this->assistant['assistantName'] ?? 'Assistent';
$assistantDialog = $this->assistant['assistantDialog'] ?? '';
$requestToken = $this->requestToken;
$labels = $this->labels;
?>

<div id="<?= $widgetId ?>"
     class="genai-chat"
     data-config='<?= htmlspecialchars(json_encode([
             'assistantId' => $assistantId,
             'requestToken' => $requestToken,
             'assistantName' => $assistantName,
             'assistantDialog' => $assistantDialog,
             'labels' => $labels,
     ], JSON_HEX_APOS | JSON_HEX_QUOT), ENT_QUOTES) ?>'
     role="region"
     aria-label="Chat">

    <?php if ($this->content['headline'] || $this->content['text']): ?>
        <header class="genai-chat__header">
            <?php if ($this->content['headline']): ?>
                <h2 class="genai-chat__title"><?= $this->content['headline'] ?></h2>
            <?php endif; ?>
            <?php if ($this->content['text']): ?>
                <p class="genai-chat__description"><?= $this->content['text'] ?></p>
            <?php endif; ?>
        </header>
    <?php endif; ?>

    <div class="genai-chat__vue-app"></div>
</div>

<script type="module">
    (function () {

        const {createApp, ref, computed, onMounted, nextTick, watch} = Vue;
        const MD = window.GenAIMarkdown;

        const parseMarkdown = (text, streaming = false) => MD.render(text, {streaming});

        const escapeHtml = (text) => MD.escapeHtml(text);

        const morphHtmlDirective = {
            mounted(el, binding) {
                el.innerHTML = binding.value || '';
            },
            updated(el, binding) {
                if (binding.value !== binding.oldValue) {
                    MD.morph(el, binding.value || '');
                }
            }
        };

        const createChatApp = (config) => {
            return {
                setup() {
                    // Config
                    const assistantId = config.assistantId;
                    const fallbackToken = config.requestToken;
                    const getRequestToken = async () => {
                        try {
                            const response = await fetch('/gen-ai/chat-component/token', {
                                method: 'GET',
                                headers: {'Accept': 'application/json'},
                                cache: 'no-store',
                                credentials: 'same-origin'
                            });
                            if (response.ok) {
                                const data = await response.json();
                                if (data.requestToken) return data.requestToken;
                            }
                        } catch (e) {
                            console.error('Token fetch failed:', e);
                        }
                        return fallbackToken;
                    };
                    const assistantName = config.assistantName;
                    const labels = config.labels;

                    // Refs
                    const messagesEl = ref(null);
                    const inputEl = ref(null);

                    // State
                    const messages = ref([]);
                    const question = ref('');
                    const isRunning = ref(false);
                    const isLoading = ref(false);
                    const errorMessage = ref('');
                    const userScrolled = ref(false);
                    const copiedMessageId = ref(null);

                    // AbortController for cancelling requests
                    let abortController = null;
                    // Increments per request; late updates of an older request are ignored
                    let runCounter = 0;

                    // Computed
                    const charCount = computed(() => question.value.length);
                    const canSend = computed(() => question.value.trim().length > 0 && !isRunning.value);

                    // Initialize: load conversation from server
                    onMounted(async () => {
                        // Add initial dialog if present
                        if (config.assistantDialog) {
                            messages.value.push({
                                id: 'initial',
                                role: 'assistant',
                                name: assistantName,
                                content: parseMarkdown(config.assistantDialog),
                                rawContent: config.assistantDialog,
                                sources: [],
                                isInitial: true
                            });
                        }

                        // Load conversation history from server
                        await loadConversation();
                        nextTick(() => scrollToBottom());
                    });

                    // Auto-scroll on new messages (streamed content scrolls in flushRender)
                    watch(() => messages.value.length, () => scrollIfPinned());

                    const scrollIfPinned = () => {
                        if (!userScrolled.value) {
                            nextTick(() => scrollToBottom());
                        }
                    };
                    const handleScroll = () => {
                        if (!messagesEl.value) return;
                        const {scrollTop, scrollHeight, clientHeight} = messagesEl.value;
                        userScrolled.value = scrollHeight - scrollTop - clientHeight > 100;
                    };
                    const scrollToBottom = (smooth = false) => {
                        if (!messagesEl.value) return;
                        messagesEl.value.scrollTo({
                            top: messagesEl.value.scrollHeight,
                            behavior: smooth ? 'smooth' : 'auto'
                        });
                    };
                    const clickScrollBtn = () => {
                        scrollToBottom(true);
                        userScrolled.value = false;
                    };
                    const autoGrow = () => {
                        if (!inputEl.value) return;
                        inputEl.value.style.height = 'auto';
                        inputEl.value.style.height = Math.min(inputEl.value.scrollHeight, 200) + 'px';
                    };
                    const handleKeydown = (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            if (canSend.value) send();
                        }
                    };
                    const send = async () => {
                        const q = question.value.trim();
                        if (!q || isRunning.value) return;

                        const runId = ++runCounter;
                        isRunning.value = true;
                        isLoading.value = true;  // Show loading immediately
                        errorMessage.value = '';
                        question.value = '';
                        userScrolled.value = false;
                        nextTick(autoGrow);

                        // Add user message
                        messages.value.push({
                            id: 'user-' + Date.now(),
                            role: 'user',
                            name: labels.you,
                            content: escapeHtml(q),
                            rawContent: q,
                            sources: []
                        });

                        // Add assistant placeholder. IMPORTANT: keep working with the reactive proxy
                        // from the array - mutating the plain object does not trigger any re-render.
                        messages.value.push({
                            id: 'assistant-' + Date.now(),
                            role: 'assistant',
                            name: assistantName,
                            content: '',
                            rawContent: '',
                            sources: [],
                            isStreaming: true,
                            interrupted: false
                        });
                        const assistantMsg = messages.value[messages.value.length - 1];

                        abortController = new AbortController();
                        const stream = createStreamRenderer(assistantMsg, runId);

                        try {
                            const response = await fetch(`/gen-ai/chat-component/ask-stream/${assistantId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'Accept': 'text/event-stream'
                                },
                                body: new URLSearchParams({
                                    question: q,
                                    REQUEST_TOKEN: await getRequestToken()
                                }),
                                signal: abortController.signal
                            });

                            if (!response.ok || !response.body) {
                                throw new Error(`HTTP ${response.status}`);
                            }

                            const result = await processStream(response, stream);

                            if (result.error) {
                                throw new Error(result.error);
                            }
                            if (!result.done) {
                                // Connection closed without the final event
                                throw new Error('Stream ended unexpectedly');
                            }

                        } catch (error) {
                            if (runId !== runCounter) return;   // chat was reset meanwhile

                            if (error.name === 'AbortError') {
                                stream.finish(`\n\n*[${labels.cancelled}]*`);
                            } else {
                                console.error('Chat error:', error);
                                errorMessage.value = labels.error;

                                if (stream.hasContent()) {
                                    // Keep what was already received
                                    assistantMsg.interrupted = true;
                                    stream.finish();
                                } else {
                                    const idx = messages.value.indexOf(assistantMsg);
                                    if (idx !== -1) messages.value.splice(idx, 1);
                                }
                            }
                        } finally {
                            stream.finish();
                            if (runId === runCounter) {
                                isRunning.value = false;
                                isLoading.value = false;
                                abortController = null;
                            }
                        }
                    };
                    const createStreamRenderer = (messageObj, runId) => {
                        let raw = '';
                        let pending = false;
                        let finished = false;

                        const flush = () => {
                            pending = false;
                            if (finished || runId !== runCounter) return;
                            messageObj.rawContent = raw;
                            messageObj.content = parseMarkdown(raw, true);
                            scrollIfPinned();
                        };

                        const schedule = () => {
                            if (pending) return;
                            pending = true;
                            // rAF pauses in background tabs -> timeout as fallback
                            const run = () => { if (pending) flush(); };
                            requestAnimationFrame(run);
                            setTimeout(run, 150);
                        };

                        return {
                            /** Full text so far (authoritative, avoids duplicated tokens) */
                            setText(text) {
                                if (finished || text === raw) return;
                                raw = text;
                                schedule();
                            },
                            appendText(token) {
                                if (finished || !token) return;
                                raw += token;
                                schedule();
                            },
                            setSources(sources) {
                                if (!finished && Array.isArray(sources)) messageObj.sources = sources;
                            },
                            hasContent: () => raw.trim() !== '',
                            /** Final render without repair -> identical to a complete Markdown render */
                            finish(suffix = '') {
                                if (finished || runId !== runCounter) return;
                                finished = true;
                                pending = false;
                                raw += suffix;
                                messageObj.rawContent = raw;
                                messageObj.content = parseMarkdown(raw, false);
                                messageObj.isStreaming = false;
                                scrollIfPinned();
                            }
                        };
                    };
                    const processStream = async (response, stream) => {
                        const reader = response.body.getReader();
                        const decoder = new TextDecoder();
                        let buffer = '';
                        let result = {done: false, error: null};

                        const handleEvent = (event) => {
                            // Per SSE spec several data lines form one payload
                            const data = event.split(/\r?\n/)
                                .filter(line => line.startsWith('data:'))
                                .map(line => line.slice(5).replace(/^ /, ''))
                                .join('\n');
                            if (!data) return;

                            let payload;
                            try {
                                payload = JSON.parse(data);
                            } catch (e) {
                                console.warn('[GenAI] Invalid stream event skipped:', data.slice(0, 200));
                                return;
                            }

                            if (payload.error) {
                                result.error = payload.error;
                                return;
                            }

                            if (payload.done) {
                                // Final event: "content" is server-rendered HTML -> keep our raw Markdown
                                result.done = true;
                                stream.setSources(payload.sources);
                                return;
                            }

                            if (typeof payload.content === 'string') {
                                stream.setText(payload.content);
                            } else if (payload.token) {
                                stream.appendText(payload.token);
                            }
                            if (payload.sources) {
                                stream.setSources(payload.sources);
                            }
                        };

                        while (!result.done && !result.error) {
                            const {done, value} = await reader.read();
                            if (done) {
                                buffer += decoder.decode();
                                if (buffer.trim()) handleEvent(buffer);
                                break;
                            }

                            buffer += decoder.decode(value, {stream: true});
                            const events = buffer.split(/\r?\n\r?\n/);
                            buffer = events.pop() || '';

                            for (const event of events) {
                                handleEvent(event);
                                if (result.done || result.error) break;
                            }
                        }

                        if (result.done || result.error) {
                            reader.cancel().catch(() => {});
                        }

                        return result;
                    };
                    const stop = () => {
                        if (abortController) {
                            abortController.abort();
                        }
                    };
                    const handleSubmit = () => {
                        if (isRunning.value) {
                            stop();
                        } else {
                            send();
                        }
                    };
                    const reset = async () => {
                        // Cancel a running answer; its late updates are ignored via runCounter
                        stop();
                        runCounter++;
                        isRunning.value = false;
                        isLoading.value = false;

                        // Keep only initial message
                        messages.value = messages.value.filter(m => m.isInitial);

                        // Reset on server
                        try {
                            await fetch(`/gen-ai/chat-component/conversation/${assistantId}/reset`, {
                                method: 'POST',
                                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                body: new URLSearchParams({REQUEST_TOKEN: await getRequestToken()})
                            });
                        } catch (e) {
                            console.error('Reset failed:', e);
                        }

                        errorMessage.value = '';
                        nextTick(() => inputEl.value?.focus());
                    };
                    const copyMessage = async (message) => {
                        try {
                            await navigator.clipboard.writeText(message.rawContent);
                            copiedMessageId.value = message.id;
                            setTimeout(() => {
                                copiedMessageId.value = null;
                            }, 2000);
                        } catch (e) {
                            console.error('Copy failed:', e);
                        }
                    };
                    const retry = () => {
                        errorMessage.value = '';
                        // Find last user message and resend
                        const lastUserMsg = [...messages.value].reverse().find(m => m.role === 'user');
                        if (lastUserMsg) {
                            question.value = lastUserMsg.rawContent;
                            // Remove the failed response attempt (partial answer + its question)
                            if (messages.value[messages.value.length - 1]?.interrupted) {
                                messages.value.pop();
                            }
                            if (messages.value[messages.value.length - 1]?.role === 'user') {
                                messages.value.pop();
                            }
                            send();
                        }
                    };
                    const loadConversation = async () => {
                        try {
                            const response = await fetch(`/gen-ai/chat-component/conversation/${assistantId}`, {
                                method: 'POST',
                                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                body: new URLSearchParams({REQUEST_TOKEN: await getRequestToken()})
                            });

                            if (!response.ok) return;

                            const serverMessages = await response.json();
                            if (!Array.isArray(serverMessages) || serverMessages.length === 0) return;

                            serverMessages.forEach((m, idx) => {
                                // User messages are plain text, assistant messages are already HTML from server
                                let displayContent;
                                if (m.role === 'user') {
                                    displayContent = escapeHtml(m.content);
                                } else {
                                    // Assistant content is already HTML (MarkdownExtra on server)
                                    // Just sanitize for safety
                                    displayContent = MD.sanitize(m.content);
                                }

                                messages.value.push({
                                    id: `server-${idx}-${m.createdAt || Date.now()}`,
                                    role: m.role,
                                    name: m.name || (m.role === 'user' ? labels.you : assistantName),
                                    content: displayContent,
                                    rawContent: m.content,
                                    sources: m.sources || [],
                                    isInitial: false
                                });
                            });
                        } catch (e) {
                            console.error('Failed to load conversation:', e);
                        }
                    };

                    return {
                        // State
                        messages,
                        question,
                        isRunning,
                        isLoading,
                        errorMessage,
                        userScrolled,
                        copiedMessageId,
                        charCount,
                        canSend,
                        // Refs
                        messagesEl,
                        inputEl,
                        // Config
                        labels,
                        assistantName,
                        // Methods
                        handleScroll,
                        clickScrollBtn,
                        autoGrow,
                        handleKeydown,
                        handleSubmit,
                        reset,
                        copyMessage,
                        retry,
                        parseMarkdown
                    };
                },

                template: `
                <div class="genai-chat__messages" 
                     ref="messagesEl"
                     role="log" 
                     aria-live="polite" 
                     aria-atomic="false"
                     tabindex="0"
                     @scroll="handleScroll">
                    
                    <article v-for="msg in messages" 
                             :key="msg.id"
                             :class="['genai-chat__message', 'genai-chat__message--' + msg.role, {'genai-chat__message--streaming': msg.isStreaming, 'genai-chat__message--interrupted': msg.interrupted}]"
                             :aria-busy="msg.isStreaming ? 'true' : 'false'"
                             :data-role="msg.role">
                        <div class="genai-chat__message-header">
                            <span class="genai-chat__message-name">[[ msg.name ]]</span>
                            <button v-if="msg.role === 'assistant' && !msg.isStreaming"
                                    type="button" 
                                    class="genai-chat__copy-btn" 
                                    :title="labels.copy"
                                    @click="copyMessage(msg)">
                                <span v-if="copiedMessageId === msg.id" style="font-size:12px">[[ labels.copied ]]</span>
                                <svg v-else width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                            </button>
                        </div>
                        <div class="genai-chat__message-content">
                            <div v-if="msg.isStreaming && !msg.content" class="genai-chat__typing">
                                <span></span><span></span><span></span>
                            </div>
                            <div v-else class="genai-chat__markdown" v-morph-html="msg.content"></div>
                        </div>
                        <div v-if="msg.sources && msg.sources.length" class="genai-chat__message-sources">
                            <details>
                                <summary>[[ labels.sources ]] ([[ msg.sources.length ]])</summary>
                                <ul>
                                    <li v-for="(source, idx) in msg.sources" :key="idx">
                                        <a :href="source.url" target="_blank" rel="noopener noreferrer">[[ source.name ]]</a>
                                    </li>
                                </ul>
                            </details>
                        </div>
                    </article>
                </div>

                <!-- Scroll indicator -->
                <button class="genai-chat__scroll-btn"
                type="button"
                v-show="userScrolled"
                :aria-label="labels.scrollDown"
                @click="clickScrollBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
                </button>

                    <!-- Loading indicator -->
                <div class="genai-chat__loading" v-show="isLoading" :aria-hidden="String(!isLoading)">
                <div class="genai-chat__loading-dots">
                <span></span><span></span><span></span>
                </div>
                <span class="genai-chat__loading-text">[[ labels.loading ]]</span>
                </div>

                    <!-- Error message -->
                <div class="genai-chat__error" v-show="errorMessage" role="alert">
                <span class="genai-chat__error-text">[[ errorMessage ]]</span>
                <button type="button" class="genai-chat__error-retry" @click="retry">
                [[ labels.retry ]]
                </button>
                </div>

                    <!-- Input area -->
                <form class="genai-chat__form" autocomplete="off" @submit.prevent="handleSubmit">
                <div class="genai-chat__input-row">
                <div class="genai-chat__input-wrapper">
                <textarea
                ref="inputEl"
                class="genai-chat__input"
                name="question"
                v-model="question"
                :placeholder="labels.placeholder"
                rows="1"
                maxlength="4000"
                :aria-label="labels.placeholder"
                :disabled="isRunning"
                required
                @input="autoGrow"
                @keydown="handleKeydown"
                ></textarea>
                <span class="genai-chat__char-count" aria-hidden="true">
                <span class="genai-chat__char-current">[[ charCount ]]</span>/4000
                </span>
                </div>

                <button type="submit"
                class="genai-chat__btn genai-chat__btn--send"
                :aria-label="isRunning ? labels.stop : labels.send">
                <svg v-if="!isRunning" class="genai-chat__icon-send" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                </svg>
                <svg v-else class="genai-chat__icon-stop" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <rect x="6" y="6" width="12" height="12" rx="2"/>
                </svg>
                </button>
                </div>

                <div class="genai-chat__actions">
                <button type="button"
                class="genai-chat__btn genai-chat__btn--reset"
                :title="labels.newChat"
                @click="reset">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
                </svg>
                <span class="genai-chat__btn-text">[[ labels.newChat ]]</span>
                </button>
                </div>
                </form>
                `

                };
            };
            const initChat = (container) => {
                if (container._vueApp) return;

                const configStr = container.dataset.config;
                if (!configStr) return;

                let config;
                try {
                    config = JSON.parse(configStr);
                } catch (e) {
                    console.error('Failed to parse chat config:', e);
                    return;
                }

                const mountPoint = container.querySelector('.genai-chat__vue-app');
                if (!mountPoint) return;

                const app = createApp(createChatApp(config));
                app.directive('morph-html', morphHtmlDirective);
                // Use [[ ]] instead of {{ }} to avoid Contao insert tag parsing
                app.config.compilerOptions.delimiters = ['[[', ']]'];
                app.mount(mountPoint);
                container._vueApp = app;
                container.style.opacity = '1';
            };

            // Initialize on DOM ready
            const init = () => {
                document.querySelectorAll('.genai-chat[data-config]').forEach(initChat);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
</script>
