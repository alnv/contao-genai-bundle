<?php
/**
 * GenAI Chat Component Template - Vue 3 Implementation
 *
 * Features:
 * - Vue 3 Composition API via CDN
 * - SSE streaming
 * - Markdown rendering via marked.js + DOMPurify
 * - Auto-scroll with user detection
 * - Server-side conversation history (tl_genai_conversations)
 * - Multiple instances support
 * - Accessibility (aria-live, keyboard navigation)
 * - Dark mode support
 */

$widgetId = $this->templateId;
$assistantId = $this->assistantId;
$assistantName = $this->assistant['assistantName'] ?? 'Assistent';
$assistantDialog = $this->assistant['assistantDialog'] ?? '';
$requestToken = $this->requestToken;
$labels = $this->labels;
?>

<div id="<?= $widgetId ?>"
     class="genai-chat"
     data-config='<?= htmlspecialchars(json_encode([
             'assistantId' => $assistantId,
             'requestToken' => $requestToken,
             'assistantName' => $assistantName,
             'assistantDialog' => $assistantDialog,
             'labels' => $labels,
     ], JSON_HEX_APOS | JSON_HEX_QUOT), ENT_QUOTES) ?>'
     role="region"
     aria-label="Chat">

    <?php if ($this->content['headline'] || $this->content['text']): ?>
        <header class="genai-chat__header">
            <?php if ($this->content['headline']): ?>
                <h2 class="genai-chat__title"><?= $this->content['headline'] ?></h2>
            <?php endif; ?>
            <?php if ($this->content['text']): ?>
                <p class="genai-chat__description"><?= $this->content['text'] ?></p>
            <?php endif; ?>
        </header>
    <?php endif; ?>

    <!-- Vue App Mount Point -->
    <div class="genai-chat__vue-app"></div>
</div>

<script type="module">
    (function () {

        const {createApp, ref, computed, onMounted, nextTick, watch} = Vue;

        /**
         * Parse Markdown using marked.js and sanitize with DOMPurify
         */
        const parseMarkdown = (text) => {
            if (!text) return '';

            if (typeof marked !== 'undefined' && typeof DOMPurify !== 'undefined') {
                try {
                    marked.setOptions({
                        gfm: true,
                        breaks: true,
                        pedantic: false,
                        headerIds: false,
                        mangle: false,
                    });

                    const rawHtml = marked.parse(text);
                    const cleanHtml = DOMPurify.sanitize(rawHtml, {
                        ALLOWED_TAGS: [
                            'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
                            'p', 'br', 'hr',
                            'ul', 'ol', 'li',
                            'strong', 'em', 'b', 'i', 'u', 's', 'del',
                            'a', 'code', 'pre',
                            'blockquote', 'q',
                            'table', 'thead', 'tbody', 'tr', 'th', 'td',
                            'img', 'figure', 'figcaption',
                            'span', 'div', 'sup', 'sub'
                        ],
                        ALLOWED_ATTR: [
                            'href', 'target', 'rel', 'title', 'alt', 'src',
                            'class', 'id', 'colspan', 'rowspan', 'align'
                        ],
                        ALLOW_DATA_ATTR: false,
                        FORBID_TAGS: ['script', 'style', 'iframe', 'form', 'input', 'button', 'object', 'embed'],
                        FORBID_ATTR: ['onerror', 'onload', 'onclick', 'onmouseover', 'style'],
                    });

                    // Add target="_blank" and rel="noopener" to external links
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = cleanHtml;
                    tempDiv.querySelectorAll('a[href]').forEach(link => {
                        if (link.href && !link.href.startsWith(window.location.origin)) {
                            link.setAttribute('target', '_blank');
                            link.setAttribute('rel', 'noopener noreferrer');
                        }
                    });

                    return tempDiv.innerHTML;
                } catch (e) {
                    console.error('Markdown parsing error:', e);
                }
            }

            return fallbackParse(text);
        };

        /**
         * Fallback parser when marked.js is not available
         */
        const fallbackParse = (text) => {
            let html = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            html = html
                .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code class="language-$1">$2</code></pre>')
                .replace(/`([^`]+)`/g, '<code>$1</code>')
                .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                .replace(/\*([^*]+)\*/g, '<em>$1</em>')
                .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
                .replace(/^### (.+)$/gm, '<h4>$1</h4>')
                .replace(/^## (.+)$/gm, '<h3>$1</h3>')
                .replace(/^# (.+)$/gm, '<h2>$1</h2>')
                .replace(/^\s*[-*]\s+(.+)$/gm, '<li>$1</li>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>');

            return '<p>' + html + '</p>';
        };

        /**
         * Escape HTML for safe text display
         */
        const escapeHtml = (text) => {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        };

        /**
         * GenAI Chat Vue Component
         */
        const createChatApp = (config) => {
            return {
                setup() {
                    // Config
                    const assistantId = config.assistantId;
                    const requestToken = config.requestToken;
                    const assistantName = config.assistantName;
                    const labels = config.labels;

                    // Refs
                    const messagesEl = ref(null);
                    const inputEl = ref(null);

                    // State
                    const messages = ref([]);
                    const question = ref('');
                    const isRunning = ref(false);
                    const isLoading = ref(false);
                    const errorMessage = ref('');
                    const userScrolled = ref(false);
                    const copiedMessageId = ref(null);

                    // AbortController for cancelling requests
                    let abortController = null;

                    // Computed
                    const charCount = computed(() => question.value.length);
                    const canSend = computed(() => question.value.trim().length > 0 && !isRunning.value);

                    // Initialize: load conversation from server
                    onMounted(async () => {
                        // Add initial dialog if present
                        if (config.assistantDialog) {
                            messages.value.push({
                                id: 'initial',
                                role: 'assistant',
                                name: assistantName,
                                content: parseMarkdown(config.assistantDialog),
                                rawContent: config.assistantDialog,
                                sources: [],
                                isInitial: true
                            });
                        }

                        // Load conversation history from server
                        await loadConversation();
                        nextTick(() => scrollToBottom());
                    });

                    // Watch messages for auto-scroll
                    watch(messages, () => {
                        if (!userScrolled.value) {
                            nextTick(() => scrollToBottom());
                        }
                    }, {deep: true});

                    /**
                     * Handle scroll detection
                     */
                    const handleScroll = () => {
                        if (!messagesEl.value) return;
                        const {scrollTop, scrollHeight, clientHeight} = messagesEl.value;
                        userScrolled.value = scrollHeight - scrollTop - clientHeight > 100;
                    };

                    /**
                     * Scroll to bottom
                     */
                    const scrollToBottom = (smooth = false) => {
                        if (!messagesEl.value) return;
                        messagesEl.value.scrollTo({
                            top: messagesEl.value.scrollHeight,
                            behavior: smooth ? 'smooth' : 'auto'
                        });
                    };

                    /**
                     * Click scroll button
                     */
                    const clickScrollBtn = () => {
                        scrollToBottom(true);
                        userScrolled.value = false;
                    };

                    /**
                     * Auto-grow textarea
                     */
                    const autoGrow = () => {
                        if (!inputEl.value) return;
                        inputEl.value.style.height = 'auto';
                        inputEl.value.style.height = Math.min(inputEl.value.scrollHeight, 200) + 'px';
                    };

                    /**
                     * Handle keydown
                     */
                    const handleKeydown = (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            if (canSend.value) send();
                        }
                    };

                    /**
                     * Send message
                     */
                    const send = async () => {
                        const q = question.value.trim();
                        if (!q || isRunning.value) return;

                        isRunning.value = true;
                        isLoading.value = true;  // Show loading immediately
                        errorMessage.value = '';
                        question.value = '';
                        nextTick(autoGrow);

                        // Add user message
                        const userMsg = {
                            id: 'user-' + Date.now(),
                            role: 'user',
                            name: labels.you,
                            content: escapeHtml(q),
                            rawContent: q,
                            sources: []
                        };
                        messages.value.push(userMsg);

                        // Add assistant placeholder
                        const assistantMsg = {
                            id: 'assistant-' + Date.now(),
                            role: 'assistant',
                            name: assistantName,
                            content: '',
                            rawContent: '',
                            sources: [],
                            isStreaming: true
                        };
                        messages.value.push(assistantMsg);

                        abortController = new AbortController();

                        try {
                            const response = await fetch(`/gen-ai/chat-component/ask-stream/${assistantId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'Accept': 'text/event-stream'
                                },
                                body: new URLSearchParams({
                                    question: q,
                                    REQUEST_TOKEN: requestToken
                                }),
                                signal: abortController.signal
                            });

                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}`);
                            }

                            await processStream(response, assistantMsg);

                        } catch (error) {
                            if (error.name === 'AbortError') {
                                assistantMsg.rawContent += '\n\n[' + labels.cancelled + ']';
                                assistantMsg.content = parseMarkdown(assistantMsg.rawContent);
                            } else {
                                console.error('Chat error:', error);
                                errorMessage.value = labels.error;
                                // Remove failed assistant message
                                const idx = messages.value.findIndex(m => m.id === assistantMsg.id);
                                if (idx !== -1) messages.value.splice(idx, 1);
                            }
                        } finally {
                            assistantMsg.isStreaming = false;
                            isRunning.value = false;
                            isLoading.value = false;
                            abortController = null;
                        }
                    };

                    /**
                     * Process SSE stream
                     */
                    const processStream = async (response, messageObj) => {
                        const reader = response.body.getReader();
                        const decoder = new TextDecoder();
                        let buffer = '';
                        let content = '';
                        let sources = [];

                        while (true) {
                            const {done, value} = await reader.read();
                            if (done) break;

                            buffer += decoder.decode(value, {stream: true});
                            const events = buffer.split('\n\n');
                            buffer = events.pop() || '';

                            for (const event of events) {
                                if (!event.trim()) continue;

                                const match = event.match(/^data:\s*(.+)$/m);
                                if (!match) continue;

                                try {
                                    const data = JSON.parse(match[1]);

                                    if (data.error) {
                                        throw new Error(data.error);
                                    }

                                    if (data.token) {
                                        content += data.token;
                                        messageObj.rawContent = content;
                                        messageObj.content = parseMarkdown(content);
                                        if (!userScrolled.value) {
                                            nextTick(() => scrollToBottom());
                                        }
                                    }

                                    if (data.sources) {
                                        sources = data.sources;
                                    }

                                    if (data.done) {
                                        messageObj.sources = sources;
                                    }
                                } catch (e) {
                                    console.error('Parse error:', e);
                                }
                            }
                        }
                    };

                    /**
                     * Stop streaming
                     */
                    const stop = () => {
                        if (abortController) {
                            abortController.abort();
                        }
                    };

                    /**
                     * Handle form submit
                     */
                    const handleSubmit = () => {
                        if (isRunning.value) {
                            stop();
                        } else {
                            send();
                        }
                    };

                    /**
                     * Reset chat
                     */
                    const reset = async () => {
                        // Keep only initial message
                        messages.value = messages.value.filter(m => m.isInitial);

                        // Reset on server
                        try {
                            await fetch(`/gen-ai/chat-component/conversation/${assistantId}/reset`, {
                                method: 'POST',
                                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                body: new URLSearchParams({REQUEST_TOKEN: requestToken})
                            });
                        } catch (e) {
                            console.error('Reset failed:', e);
                        }

                        errorMessage.value = '';
                        nextTick(() => inputEl.value?.focus());
                    };

                    /**
                     * Copy message content
                     */
                    const copyMessage = async (message) => {
                        try {
                            await navigator.clipboard.writeText(message.rawContent);
                            copiedMessageId.value = message.id;
                            setTimeout(() => {
                                copiedMessageId.value = null;
                            }, 2000);
                        } catch (e) {
                            console.error('Copy failed:', e);
                        }
                    };

                    /**
                     * Retry last question
                     */
                    const retry = () => {
                        errorMessage.value = '';
                        // Find last user message and resend
                        const lastUserMsg = [...messages.value].reverse().find(m => m.role === 'user');
                        if (lastUserMsg) {
                            question.value = lastUserMsg.rawContent;
                            // Remove the failed response attempt
                            const lastIdx = messages.value.length - 1;
                            if (messages.value[lastIdx]?.role === 'user') {
                                messages.value.pop();
                            }
                            send();
                        }
                    };

                    /**
                     * Load conversation history from server
                     */
                    const loadConversation = async () => {
                        try {
                            const response = await fetch(`/gen-ai/chat-component/conversation/${assistantId}`, {
                                method: 'POST',
                                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                                body: new URLSearchParams({REQUEST_TOKEN: requestToken})
                            });

                            if (!response.ok) return;

                            const serverMessages = await response.json();
                            if (!Array.isArray(serverMessages) || serverMessages.length === 0) return;

                            serverMessages.forEach((m, idx) => {
                                // User messages are plain text, assistant messages are already HTML from server
                                let displayContent;
                                if (m.role === 'user') {
                                    displayContent = escapeHtml(m.content);
                                } else {
                                    // Assistant content is already HTML (MarkdownExtra on server)
                                    // Just sanitize for safety
                                    displayContent = typeof DOMPurify !== 'undefined'
                                        ? DOMPurify.sanitize(m.content)
                                        : m.content;
                                }

                                messages.value.push({
                                    id: `server-${idx}-${m.createdAt || Date.now()}`,
                                    role: m.role,
                                    name: m.name || (m.role === 'user' ? labels.you : assistantName),
                                    content: displayContent,
                                    rawContent: m.content,
                                    sources: m.sources || [],
                                    isInitial: false
                                });
                            });
                        } catch (e) {
                            console.error('Failed to load conversation:', e);
                        }
                    };

                    return {
                        // State
                        messages,
                        question,
                        isRunning,
                        isLoading,
                        errorMessage,
                        userScrolled,
                        copiedMessageId,
                        charCount,
                        canSend,
                        // Refs
                        messagesEl,
                        inputEl,
                        // Config
                        labels,
                        assistantName,
                        // Methods
                        handleScroll,
                        clickScrollBtn,
                        autoGrow,
                        handleKeydown,
                        handleSubmit,
                        reset,
                        copyMessage,
                        retry,
                        parseMarkdown
                    };
                },

                template: `
                <div class="genai-chat__messages" 
                     ref="messagesEl"
                     role="log" 
                     aria-live="polite" 
                     aria-atomic="false"
                     tabindex="0"
                     @scroll="handleScroll">
                    
                    <article v-for="msg in messages" 
                             :key="msg.id"
                             :class="['genai-chat__message', 'genai-chat__message--' + msg.role]"
                             :data-role="msg.role">
                        <div class="genai-chat__message-header">
                            <span class="genai-chat__message-name">[[ msg.name ]]</span>
                            <button v-if="msg.role === 'assistant' && !msg.isStreaming"
                                    type="button" 
                                    class="genai-chat__copy-btn" 
                                    :title="labels.copy"
                                    @click="copyMessage(msg)">
                                <span v-if="copiedMessageId === msg.id" style="font-size:12px">[[ labels.copied ]]</span>
                                <svg v-else width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                            </button>
                        </div>
                        <div class="genai-chat__message-content">
                            <div v-if="msg.isStreaming && !msg.content" class="genai-chat__typing">
                                <span></span><span></span><span></span>
                            </div>
                            <div v-else v-html="msg.content"></div>
                        </div>
                        <div v-if="msg.sources && msg.sources.length" class="genai-chat__message-sources">
                            <details>
                                <summary>[[ labels.sources ]] ([[ msg.sources.length ]])</summary>
                                <ul>
                                    <li v-for="(source, idx) in msg.sources" :key="idx">
                                        <a :href="source.url" target="_blank" rel="noopener noreferrer">[[ source.name ]]</a>
                                    </li>
                                </ul>
                            </details>
                        </div>
                    </article>
                </div>

                <!-- Scroll indicator -->
                <button class="genai-chat__scroll-btn"
                type="button"
                v-show="userScrolled"
                :aria-label="labels.scrollDown"
                @click="clickScrollBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12l7 7 7-7"/>
                </svg>
                </button>

                    <!-- Loading indicator -->
                <div class="genai-chat__loading" v-show="isLoading" :aria-hidden="String(!isLoading)">
                <div class="genai-chat__loading-dots">
                <span></span><span></span><span></span>
                </div>
                <span class="genai-chat__loading-text">[[ labels.loading ]]</span>
                </div>

                    <!-- Error message -->
                <div class="genai-chat__error" v-show="errorMessage" role="alert">
                <span class="genai-chat__error-text">[[ errorMessage ]]</span>
                <button type="button" class="genai-chat__error-retry" @click="retry">
                [[ labels.retry ]]
                </button>
                </div>

                    <!-- Input area -->
                <form class="genai-chat__form" autocomplete="off" @submit.prevent="handleSubmit">
                <div class="genai-chat__input-row">
                <div class="genai-chat__input-wrapper">
                <textarea
                ref="inputEl"
                class="genai-chat__input"
                name="question"
                v-model="question"
                :placeholder="labels.placeholder"
                rows="1"
                maxlength="4000"
                :aria-label="labels.placeholder"
                :disabled="isRunning"
                required
                @input="autoGrow"
                @keydown="handleKeydown"
                ></textarea>
                <span class="genai-chat__char-count" aria-hidden="true">
                <span class="genai-chat__char-current">[[ charCount ]]</span>/4000
                </span>
                </div>

                <button type="submit"
                class="genai-chat__btn genai-chat__btn--send"
                :aria-label="isRunning ? labels.stop : labels.send">
                <svg v-if="!isRunning" class="genai-chat__icon-send" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                </svg>
                <svg v-else class="genai-chat__icon-stop" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <rect x="6" y="6" width="12" height="12" rx="2"/>
                </svg>
                </button>
                </div>

                <div class="genai-chat__actions">
                <button type="button"
                class="genai-chat__btn genai-chat__btn--reset"
                :title="labels.newChat"
                @click="reset">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
                </svg>
                <span class="genai-chat__btn-text">[[ labels.newChat ]]</span>
                </button>
                </div>
                </form>
                `

                };
            };

            /**
             * Initialize Vue app for this container
             */
            const initChat = (container) => {
                if (container._vueApp) return;

                const configStr = container.dataset.config;
                if (!configStr) return;

                let config;
                try {
                    config = JSON.parse(configStr);
                } catch (e) {
                    console.error('Failed to parse chat config:', e);
                    return;
                }

                const mountPoint = container.querySelector('.genai-chat__vue-app');
                if (!mountPoint) return;

                const app = createApp(createChatApp(config));
                // Use [[ ]] instead of {{ }} to avoid Contao insert tag parsing
                app.config.compilerOptions.delimiters = ['[[', ']]'];
                app.mount(mountPoint);
                container._vueApp = app;
                container.style.opacity = '1';
            };

            // Initialize on DOM ready
            const init = () => {
                document.querySelectorAll('.genai-chat[data-config]').forEach(initChat);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
</script>
