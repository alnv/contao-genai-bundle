{
  "name": "alnv/genai-bundle",
  "type": "contao-bundle",
  "license": "MIT",
  "description": "RAG-Chatbot für Contao CMS mit lokalen LLMs (Ollama), OpenAI/ChatGPT, OpenAI-kompatiblen APIs und ChromaDB Vektorsuche.",
  "keywords": [
    "chatbot",
    "ai",
    "llm",
    "rag",
    "ollama",
    "openai",
    "chatgpt",
    "chromadb",
    "vector-search",
    "embeddings",
    "streaming"
  ],
  "authors": [
    {
      "name": "Alexander Naumov",
      "homepage": "https://alexandernaumov.de",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Alnv\\GenaiBundle\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "contao/core-bundle": "~5.3",
    "theodo-group/llphant": "^0.11",
    "michelf/php-markdown": "^2.0",
    "menatwork/contao-multicolumnwizard-bundle": "^3.6",
    "helgesverre/chromadb": "~3.0 || ~2.2"
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "contao-manager-plugin": "Alnv\\GenaiBundle\\ContaoManager\\Plugin"
  }
}
